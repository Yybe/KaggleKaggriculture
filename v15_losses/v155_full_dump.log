0111 | def _capselllate_topup(obs, action, step):
0112 |     """Bumps high-value sell quantities late game to inflict asymmetric price pressure on opponent."""
0113 |     if step < _LATEFILL_STEP or step >= 716:
0114 |         return action
0115 |     seat = _seat(obs)
0116 |     private = _get(obs, "private", {}) or {}
0117 |     shed = dict(private.get("shed") or {})
0118 |     market = list(action.get("market") or [])
0119 |     new_market = []
0120 |     for order in market:
0121 |         if (isinstance(order, (list, tuple)) and len(order) >= 3 and order[0] == "SELL"):
0122 |             item = str(order[1])
0123 |             if item in _HIGH_VALUE:
0124 |                 try:
0125 |                     qty = int(order[2])
0126 |                 except (TypeError, ValueError):
0127 |                     qty = 0
0128 |                 available = int(shed.get(item, 0) or 0)
0129 |                 if available > qty:
0130 |                     order = [order[0], order[1], qty + min(_BUMP_CAP, available - qty)]
0131 |         new_market.append(list(order))
0132 |     action["market"] = new_market
0133 |     return action
0134 | 
0135 | 
0136 | def _recovery_sell(obs, action, step):
0137 |     """Front-loads surplus high-value sells into price-recovery windows.
0138 | 
0139 |     Forensics (5 real V15 losses): opponents sell surplus STR/MILK when the
0140 |     shared market price recovers (px 32-85) as town shops drain inventory,
0141 |     while V15's tape dumps at fixed late steps into crashes (px 1-24).
0142 |     This pass sells up to _RECOVERY_CHUNK units of surplus high-value shed
0143 |     inventory at the FRONT of the market queue whenever price >= gate,
0144 |     from day ~24 through the day-29 recovery (before terminal liquidation).
0145 |     """
0146 |     if step < _RECOVERY_START or step >= _RECOVERY_STOP:
0147 |         return action
0148 |     seat = _seat(obs)
0149 |     private = _get(obs, "private", {}) or {}
0150 |     shed = dict(private.get("shed") or {})
0151 |     prices = _get(_get(obs, "market", {}) or {}, "prices", {}) or {}
0152 |     market = list(action.get("market") or [])
0153 |     planned = {item: 0 for item in _SELLABLE}
0154 |     for order in market:
0155 |         if isinstance(order, (list, tuple)) and len(order) >= 3 and order[0] == "SELL":
0156 |             planned[str(order[1])] += max(0, int(order[2]))
0157 |     new_orders = []
0158 |     for item in _RECOVERY_PRIORITY:
0159 |         if len(market) + len(new_orders) >= 10:
0160 |             break
0161 |         available = max(0, int(shed.get(item, 0) or 0))
0162 |         surplus = available - planned.get(item, 0)
0163 |         if surplus < 1:
0164 |             continue
0165 |         price = int(prices.get(item, 0) or 0)
0166 |         if price < _RECOVERY_GATES.get(item, 0):
0167 |             continue
0168 |         chunk = min(surplus, _RECOVERY_CHUNK)
0169 |         new_orders.append(["SELL", item, chunk])
0170 |     if new_orders:
0171 |         action["market"] = new_orders + market
0172 |     return action
0173 | 
