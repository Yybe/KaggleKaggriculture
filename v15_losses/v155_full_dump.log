0175 | def agent(obs, configuration=None):
0176 |     try:
0177 |         step = min(max(0, int(_get(obs, "step", 0) or 0)), len(_ACTIONS) - 1)
0178 |         action = _weed_repair_action(obs, _copy_action(_ACTIONS[step]), step)
0179 |         action = _idle_fill(obs, action, step)
0180 |         action = _repay_shift(obs, action, step)
0181 |         action = _rank_sell_slots(obs, action, None)
0182 |         action = _preempt_shift(obs, action, step)
0183 |         action = _capselllate_topup(obs, action, step)
0184 |         action = _recovery_sell(obs, action, step)
0185 |         action = _terminal_liquidation(obs, action, step)
0186 |         return _align_hands(action, obs)
0187 |     except Exception:
0188 |         farm = _farm(obs, _seat(obs))
0189 |         return {
0190 |             "farmer": ["PASS"],
0191 |             "hands": [["PASS"] for _ in (_get(farm, "hands", []) or [])],
0192 |             "market": [],
0193 |         }
0194 | 
0195 | 
0196 | def _kaggle_submission_entrypoint(obs, configuration=None):
0197 |     return agent(obs, configuration)
