0084 | def _idle_fill(obs, action, step):
0085 |     """Fills idle PASS turns with safe non-negative actions."""
0086 |     seat = _seat(obs)
0087 |     farm = _farm(obs, seat)
0088 |     positions = [_get(farm, "farmer"), *list(_get(farm, "hands", []) or [])]
0089 |     units = [action["farmer"], *action["hands"]]
0090 | 
0091 |     for index, (position, planned) in enumerate(zip(positions, units)):
0092 |         if not planned or planned[0] != "PASS":
0093 |             continue
0094 |         tile = _tile_at(farm, position)
0095 |         if not isinstance(tile, dict):
0096 |             continue
0097 | 
0098 |         if tile.get("kind") == "PLANT":
0099 |             crop = tile.get("crop")
0100 |             if crop in _NON_ONGOING_MAX:
0101 |                 if int(tile.get("yield_units", 0) or 0) >= _NON_ONGOING_MAX[crop]:
0102 |                     units[index] = ["HARVEST"]
0103 |                 elif not tile.get("watered_today", False):
0104 |                     units[index] = ["WATER"]
0105 | 
0106 |     action["farmer"] = units[0] if units else ["PASS"]
0107 |     action["hands"] = units[1:]
0108 |     return action
0109 | 
